# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database ---
MONGODB_URI=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Site URLs ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Stripe ---
# Test secret key (sk_test_...) from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Test publishable key (pk_test_...), same page as above
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (or from the Dashboard's webhook endpoint config in production)
STRIPE_WEBHOOK_SECRET=

# --- Email / SMTP ---
EMAIL_SERVER=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=587
EMAIL_FROM=
FROM_EMAIL=
STORE_EMAIL=
STORE_NAME=
ADMIN_EMAIL=

AWS_SMTP_HOST=
AWS_SMTP_PORT=587
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (caching) ---
REDIS_URL=

# --- Affiliate module ---
AFFILIATE_ENCRYPTION_KEY=

# --- Logging ---
LOG_LEVEL=info
