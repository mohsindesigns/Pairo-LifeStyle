# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Database ---
MONGODB_URI=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# --- Site URLs ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Stripe ---
# Test secret key (sk_test_...) from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Test publishable key (pk_test_...), same page as above
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (or from the Dashboard's webhook endpoint config in production)
STRIPE_WEBHOOK_SECRET=

# --- Email / SMTP ---
EMAIL_SERVER=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PORT=587
EMAIL_FROM=
FROM_EMAIL=
STORE_EMAIL=
STORE_NAME=
ADMIN_EMAIL=

# --- Size confirmation emails: reply tracking (IMAP) ---
# Mailbox that customers' replies land in (the Reply-To on the email). Replies are
# pulled from here over IMAP and shown in the admin bell / Size Confirmations page.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Optional: override the Reply-To address and the phone shown in the email signature
SIZE_REPLY_TO=
STORE_PHONE=
# The size confirmation email is sent automatically when a paid order containing a product
# with a size chart is received. Set to "off" to disable the automatic send (manual button still works).
SIZE_CONFIRMATION_AUTO=on

AWS_SMTP_HOST=
AWS_SMTP_PORT=587
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Redis (caching) ---
REDIS_URL=

# --- Affiliate module ---
AFFILIATE_ENCRYPTION_KEY=

# --- Pinterest Conversions API (server-side purchase tracking) ---
# Access token from your Pinterest app (starts with pina_). Server-only — never expose it.
# If it was ever pasted anywhere public, rotate it in Pinterest before use.
PINTEREST_ACCESS_TOKEN=
# Your Pinterest Ad Account ID (numeric).
PINTEREST_AD_ACCOUNT_ID=

# --- Logging ---
LOG_LEVEL=info

# --- CRM Integration ---
# Shared API key for CRM to query and update orders (/api/crm/orders)
CRM_API_KEY=
# External CRM webhook URL to receive real-time order creation & status updates
CRM_WEBHOOK_URL=
# HMAC secret for validating outbound X-Pairo-Signature headers
CRM_WEBHOOK_SECRET=
